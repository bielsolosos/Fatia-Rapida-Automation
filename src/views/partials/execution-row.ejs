<tr id="exec-<%= view.id %>">
  <td class="text-sm">
    <%= view.dataFormatada %>
  </td>
  <td>
    <span class="badge badge-sm <%= view.statusBadgeClass %>">
      <%= view.status %>
    </span>
  </td>
  <td class="text-sm">
    <% if (view.origem.kind === 'tarefa') { %>
      <%= view.origem.nome %>
    <% } else if (view.origem.kind === 'script') { %>
      <span class="opacity-60">Script:</span> <%= view.origem.nome %>
    <% } else { %>
      <span class="opacity-40">(avulso)</span>
    <% } %>
  </td>
  <td class="text-sm"><%= view.duracaoLabel %></td>
  <td>
    <% if (view.temSaida) { %>
      <button
        class="btn btn-xs btn-ghost"
        hx-get="/execucoes/<%= view.id %>/detalhes"
        hx-target="#exec-detail-modal"
        hx-swap="innerHTML"
      >
        <i data-lucide="eye" class="w-3 h-3"></i> Ver
      </button>
    <% } else { %>
      <span class="text-base-content/30">—</span>
    <% } %>
  </td>
</tr>
